<template>
  <style>
    #root { position: absolute; inset: 0; overflow: hidden; background: #cfe6f7; }
    #world-canvas { position: absolute; inset: 0; width: 1080px; height: 1920px; }
  </style>
  <div id="root" data-composition-id="world" data-width="1080" data-height="1920">
    <canvas id="world-canvas" width="1080" height="1920"></canvas>
  </div>
  <script type="module">
    import * as THREE from "three";
    import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
    import { RoomEnvironment } from "three/addons/environments/RoomEnvironment.js";
    import { criarPintor, POSES, misturar } from "./assets/pintor-rig.js";

    // Tempos ancorados na narração (assets/transcript.json)
    const C = {
      d1: 4.32, chuva1: 11.0, d2: 14.56, ent2: 21.52, chuva2: 24.6, d3: 28.48, porem3: 36.32, agora3: 40.8,
      d4: 45.12, existe4: 54.8, d5: 59.76, soque5: 67.91, d6: 74.87, agora6: 85.83, d7: 90.55, faca7: 103.11,
      recap: 110.39, cta: 116.15, end: 122.84,
    };

    const sm = (a, b, t) => { const x = Math.min(1, Math.max(0, (t - a) / (b - a))); return x * x * (3 - 2 * x); };
    const lerp = (a, b, k) => a + (b - a) * k;
    function rnd(seed) { let s = seed >>> 0; return () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296); }

    const canvas = document.getElementById("world-canvas");
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, preserveDrawingBuffer: true });
    renderer.setPixelRatio(1);
    renderer.setSize(1080, 1920, false);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;

    const scene = new THREE.Scene();
    scene.environment = new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(), 0.04).texture;
    scene.environmentIntensity = 0.55;
    const camera = new THREE.PerspectiveCamera(36, 1080 / 1920, 0.05, 80);

    const sol = new THREE.DirectionalLight("#fff0d8", 2.4);
    sol.castShadow = true; sol.shadow.mapSize.set(2048, 2048);
    Object.assign(sol.shadow.camera, { left: -4, right: 4, top: 4, bottom: -2, near: 0.5, far: 20 });
    const hemi = new THREE.HemisphereLight("#cfe3ff", "#9fb27a", 0.6);
    scene.add(sol, sol.target, hemi);

    // ---------- chão, calçada, grama ----------
    const mat = (c, r = 0.9) => new THREE.MeshStandardMaterial({ color: c, roughness: r });
    const grama = new THREE.Mesh(new THREE.PlaneGeometry(40, 40), mat("#7fae5a"));
    grama.rotation.x = -Math.PI / 2; grama.receiveShadow = true; scene.add(grama);
    const calcada = new THREE.Mesh(new THREE.BoxGeometry(5.2, 0.04, 1.8), mat("#c9c3b8"));
    calcada.position.set(0, 0.02, 0.9); calcada.receiveShadow = true; scene.add(calcada);

    // ---------- fachada com textura desenhada em canvas ----------
    const W = 3.4, H = 2.1;
    const tcv = document.createElement("canvas"); tcv.width = 1024; tcv.height = 632;
    const g = tcv.getContext("2d");
    const wallTex = new THREE.CanvasTexture(tcv); wallTex.colorSpace = THREE.SRGBColorSpace; wallTex.anisotropy = 4;
    const wallMat = new THREE.MeshStandardMaterial({ map: wallTex, roughness: 0.92 });
    const parede = new THREE.Mesh(new THREE.BoxGeometry(W, H, 0.2), [mat("#bdb6a8"), mat("#bdb6a8"), mat("#bdb6a8"), mat("#bdb6a8"), wallMat, mat("#bdb6a8")]);
    parede.position.set(0, H / 2, -0.1); parede.castShadow = true; parede.receiveShadow = true; scene.add(parede);
    // telhado de duas águas
    const tel = new THREE.Shape(); tel.moveTo(-W / 2 - 0.25, 0); tel.lineTo(0, 1.0); tel.lineTo(W / 2 + 0.25, 0); tel.lineTo(-W / 2 - 0.25, 0);
    const telhado = new THREE.Mesh(new THREE.ExtrudeGeometry(tel, { depth: 0.5, bevelEnabled: false }), mat("#b5523b", 0.8));
    telhado.position.set(0, H, -0.45); telhado.castShadow = true; scene.add(telhado);
    const oitao = new THREE.Mesh(new THREE.ShapeGeometry((() => { const s = new THREE.Shape(); s.moveTo(-W / 2, 0); s.lineTo(0, 0.86); s.lineTo(W / 2, 0); return s; })()), mat("#bdb6a8"));
    oitao.position.set(0, H, 0.001); scene.add(oitao);
    // porta e janela (molduras azul-marinho)
    function moldura(x, y, w, h) {
      const gq = new THREE.Group();
      const vidro = new THREE.Mesh(new THREE.BoxGeometry(w, h, 0.05), mat(h > 0.9 ? "#5b3a24" : "#8fb8d8", 0.5));
      gq.add(vidro);
      const m = mat("#1b2f8a", 0.6);
      for (const [px, py, sw, sh] of [[0, h / 2, w + 0.1, 0.06], [0, -h / 2, w + 0.1, 0.06], [-w / 2, 0, 0.06, h], [w / 2, 0, 0.06, h]]) {
        const b = new THREE.Mesh(new THREE.BoxGeometry(sw, sh, 0.08), m); b.position.set(px, py, 0.02); gq.add(b);
      }
      gq.position.set(x, y, 0.03); gq.traverse((o) => { if (o.isMesh) o.castShadow = true; }); scene.add(gq);
    }
    moldura(-0.95, 0.62, 0.62, 1.2);
    moldura(0.85, 1.15, 0.9, 0.62);

    // estados da parede
    const R = rnd(7);
    const manchas = Array.from({ length: 70 }, () => [R(), R(), 6 + R() * 30, R()]);
    const gotas = Array.from({ length: 90 }, () => [R(), R() * 0.5, 0.15 + R() * 0.45, 2 + R() * 4]);
    const placas = [...Array.from({ length: 26 }, () => [R(), 0.08 + R() * 0.8, 20 + R() * 55, 14 + R() * 40, R()]), ...Array.from({ length: 22 }, () => [0.42 + R() * 0.36, 0.3 + R() * 0.45, 30 + R() * 50, 20 + R() * 34, R()])];
    const trincas = Array.from({ length: 5 }, (_, i) => { const r2 = rnd(100 + i); const pts = [[0.12 + i * 0.19 + r2() * 0.05, 0.15 + r2() * 0.2]]; for (let k = 0; k < 9; k++) { const [x, y] = pts[pts.length - 1]; pts.push([x + (r2() - 0.5) * 0.05, y + 0.05 + r2() * 0.03]); } return pts; });
    const fios = Array.from({ length: 40 }, (_, i) => { const r2 = rnd(300 + i); const x = r2(), y = r2() * 0.9; return [[x, y], [x + (r2() - 0.5) * 0.06, y + 0.03 + r2() * 0.04], [x + (r2() - 0.5) * 0.1, y + 0.06 + r2() * 0.05]]; });

    function reboco(cor = "#b9b0a1") {
      g.fillStyle = cor; g.fillRect(0, 0, 1024, 632);
      const r = rnd(11);
      for (let i = 0; i < 2600; i++) { g.fillStyle = r() < 0.5 ? "rgba(0,0,0,0.05)" : "rgba(255,255,255,0.06)"; g.fillRect(r() * 1024, r() * 632, 2 + r() * 4, 2 + r() * 4); }
    }
    function demao(cor, k, sheen = 0) { // pinta da esquerda para a direita até a fração k
      if (k <= 0) return;
      g.save(); g.beginPath(); g.rect(0, 0, 1024 * k, 632); g.clip();
      g.fillStyle = cor; g.fillRect(0, 0, 1024, 632);
      if (sheen) { const gr = g.createLinearGradient(0, 0, 0, 632); gr.addColorStop(0, `rgba(255,255,255,${sheen})`); gr.addColorStop(1, "rgba(255,255,255,0)"); g.fillStyle = gr; g.fillRect(0, 0, 1024, 632); }
      const r = rnd(23); for (let i = 0; i < 900; i++) { g.fillStyle = "rgba(0,0,0,0.025)"; g.fillRect(r() * 1024, r() * 632, 3, 3); }
      g.restore();
      if (k < 1) { g.fillStyle = "rgba(0,0,0,0.08)"; g.fillRect(1024 * k - 3, 0, 6, 632); }
    }
    function escorrido(k, cor = "rgba(150,140,120,0.55)") { // listras de chuva e manchas
      if (k <= 0) return;
      for (const [x, y, len, wdt] of gotas) { g.fillStyle = cor; g.fillRect(x * 1024, y * 632, wdt, len * 632 * k); }
      for (const [x, y, r, a] of manchas) { g.fillStyle = `rgba(120,110,95,${0.18 * k * (0.5 + a)})`; g.beginPath(); g.ellipse(x * 1024, (0.4 + y * 0.6) * 632, r * 1.6, r, 0, 0, 7); g.fill(); }
    }
    function esfarelado(k) { // PVA: pó claro e falhas
      if (k <= 0) return;
      const r = rnd(41); for (let i = 0; i < 700 * k; i++) { g.fillStyle = "rgba(255,255,255,0.35)"; g.fillRect(r() * 1024, r() * 632, 4 + r() * 10, 2 + r() * 4); }
      for (const [x, y, r2] of manchas) { g.fillStyle = `rgba(185,176,161,${0.75 * k})`; g.beginPath(); g.arc(x * 1024, y * 632, r2 * 0.8 * k, 0, 7); g.fill(); }
    }
    function descascado(k) {
      if (k <= 0) return;
      for (const [x, y, w, h, a] of placas) {
        const kk = Math.min(1, Math.max(0, k * 1.4 - a * 0.4)); if (kk <= 0) continue;
        g.fillStyle = "#b9b0a1"; g.beginPath(); g.ellipse(x * 1024, y * 632, w * kk, h * kk, a, 0, 7); g.fill();
        g.strokeStyle = "rgba(255,255,255,0.9)"; g.lineWidth = 3; g.stroke();
        g.strokeStyle = "rgba(0,0,0,0.25)"; g.lineWidth = 1.5; g.beginPath(); g.ellipse(x * 1024 + 2, y * 632 + 3, w * kk, h * kk, a, 0.2, 3); g.stroke();
      }
    }
    function trinca(k, preench = 0) {
      if (k <= 0) return;
      for (const pts of trincas) {
        const n = Math.max(2, Math.round(pts.length * k));
        g.strokeStyle = preench > 0 ? `rgba(240,236,226,${preench})` : "rgba(60,50,40,0.9)";
        g.lineWidth = preench > 0 ? 9 : 4; g.beginPath();
        pts.slice(0, n).forEach(([x, y], i) => (i ? g.lineTo(x * 1024, (1 - y) * 632) : g.moveTo(x * 1024, (1 - y) * 632))); g.stroke();
        if (preench > 0 && preench < 1) { g.strokeStyle = `rgba(60,50,40,${0.9 * (1 - preench)})`; g.lineWidth = 3; g.stroke(); }
      }
    }
    function fissuras(k) {
      if (k <= 0) return;
      g.strokeStyle = `rgba(90,80,65,${0.75 * k})`; g.lineWidth = 1.6;
      for (const f of fios.slice(0, Math.round(fios.length * k))) { g.beginPath(); f.forEach(([x, y], i) => (i ? g.lineTo(x * 1024, y * 632) : g.moveTo(x * 1024, y * 632))); g.stroke(); }
    }
    function barrado(k) { if (k <= 0) return; g.fillStyle = "#2457d6"; g.fillRect(0, 632 * 0.82, 1024 * k, 632 * 0.18); }

    const CREME = "#efd6a0";
    let chaveAnt = "";
    function desenharParede(t) {
      let ch;
      const p = (a, b) => Math.round(sm(a, b, t) * 40) / 40;
      if (t < 1.3 || t >= C.d6 + 7.3) ch = "final|" + p(C.d6 + 1, C.d6 + 7);
      else if (t < C.d2) ch = "cal|" + p(C.d1 + 1.2, C.d1 + 6) + "|" + p(C.chuva1 + 0.6, C.d2);
      else if (t < C.d3) ch = "pva|" + p(C.d2 + 0.8, C.d2 + 5.5) + "|" + p(C.chuva2 + 0.6, C.d3);
      else if (t < C.d4) ch = "acr|" + p(C.d3 + 0.6, C.d3 + 4.5) + "|" + p(C.porem3 + 1.4, C.agora3);
      else if (t < C.d5) ch = "sel|" + p(C.d4 + 0.5, C.d4 + 4.5) + "|" + p(C.d4 + 5.3, C.d4 + 9.2) + "|" + p(C.existe4 + 0.6, C.existe4 + 3);
      else if (t < C.d6) ch = "tri|" + p(C.d5 + 0.5, C.d5 + 6) + "|" + p(C.soque5 + 1, C.d6 - 0.3);
      else ch = "ela|" + p(C.d6 + 1, C.d6 + 7);
      if (ch === chaveAnt) return;
      chaveAnt = ch;
      const v = ch.split("|"), a = +v[1], b = +v[2], c = +v[3];
      if (v[0] === "final") { reboco(); demao(CREME, 1, 0.05); barrado(1); }
      else if (v[0] === "cal") { reboco(); demao("#f7f6f1", a); escorrido(b); }
      else if (v[0] === "pva") { reboco(); demao("#f7f6f1", 1); escorrido(1); demao("#ecdcb6", a); esfarelado(b); }
      else if (v[0] === "acr") { reboco(); demao(CREME, a, 0.12); if (a < 1) { g.save(); g.globalCompositeOperation = "destination-over"; g.restore(); } descascado(b); }
      else if (v[0] === "sel") { reboco("#b3aa9a"); demao("rgba(205,200,188,0.55)", b); trinca(c); }
      else if (v[0] === "tri") { reboco("#b3aa9a"); demao("rgba(205,200,188,0.55)", 1); trinca(1, a); fissuras(b); }
      else if (v[0] === "ela") { reboco("#b3aa9a"); demao("rgba(205,200,188,0.55)", 1); trinca(1, 1); fissuras(1 - a); demao(CREME, a, 0.08); barrado(a); }
      wallTex.needsUpdate = true;
    }

    // ---------- latas e ferramentas (o cenário acumula) ----------
    function lata(cor, rotulo, x, z, h = 0.16, r = 0.075) {
      const gq = new THREE.Group();
      const corpo = new THREE.Mesh(new THREE.CylinderGeometry(r, r, h, 24), mat("#d8dde4", 0.4)); corpo.position.y = h / 2; gq.add(corpo);
      const fx = new THREE.Mesh(new THREE.CylinderGeometry(r * 1.01, r * 1.01, h * 0.55, 24, 1, true), mat(rotulo, 0.7)); fx.position.y = h * 0.5; gq.add(fx);
      const tampa = new THREE.Mesh(new THREE.CylinderGeometry(r * 0.96, r * 0.96, 0.01, 24), mat(cor, 0.5)); tampa.position.y = h + 0.005; gq.add(tampa);
      gq.position.set(x, 0.04, z); gq.traverse((o) => { if (o.isMesh) o.castShadow = true; }); gq.visible = false; scene.add(gq); return gq;
    }
    const balde = (() => { const gq = new THREE.Group(); const b = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.08, 0.18, 24, 1, true), new THREE.MeshStandardMaterial({ color: "#e9eef5", roughness: 0.6, side: THREE.DoubleSide })); b.position.y = 0.09; gq.add(b); const cal = new THREE.Mesh(new THREE.CircleGeometry(0.095, 24), mat("#ffffff", 0.95)); cal.rotation.x = -Math.PI / 2; cal.position.y = 0.15; gq.add(cal); gq.position.set(0.55, 0.04, 0.75); gq.traverse((o) => { if (o.isMesh) o.castShadow = true; }); scene.add(gq); return gq; })();
    const latas = [
      [C.d2, lata("#ecdcb6", "#6b8bd6", 0.78, 0.62)],
      [C.d3, lata(CREME, "#2457d6", 1.0, 0.72)],
      [C.d4 + 5, lata("#d9d2c4", "#13733a", 1.2, 0.6)],
      [C.d5, lata("#ffffff", "#8a8f99", 1.38, 0.74, 0.12, 0.04)],
      [C.d6, lata(CREME, "#0b1220", 1.55, 0.6, 0.2, 0.09)],
    ];

    // ferramentas na mão
    const madeira = mat("#b07a45", 0.7);
    function broxa() { const gq = new THREE.Group(); const cabo = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.008, 0.12, 8), madeira); cabo.position.y = -0.04; gq.add(cabo); const cerda = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.06, 0.03), mat("#f4f1e8")); cerda.position.y = -0.12; gq.add(cerda); return gq; }
    function rolo() { const gq = new THREE.Group(); const cabo = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.008, 0.16, 8), mat("#2457d6", 0.5)); cabo.position.y = -0.05; gq.add(cabo); const haste = new THREE.Mesh(new THREE.CylinderGeometry(0.004, 0.004, 0.08, 6), mat("#9aa3ad", 0.3)); haste.position.set(0, -0.14, 0.03); haste.rotation.x = 0.6; gq.add(haste); const cil = new THREE.Mesh(new THREE.CylinderGeometry(0.025, 0.025, 0.11, 16), mat("#f6efe0")); cil.rotation.z = Math.PI / 2; cil.position.set(0, -0.17, 0.06); gq.add(cil); return gq; }
    function lixa() { const gq = new THREE.Group(); const b = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.03, 0.04), mat("#c8a46a")); b.position.y = -0.05; gq.add(b); return gq; }
    function espatula() { const gq = new THREE.Group(); const cabo = new THREE.Mesh(new THREE.BoxGeometry(0.02, 0.07, 0.015), mat("#1b2f8a")); cabo.position.y = -0.04; gq.add(cabo); const lam = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.05, 0.003), mat("#c9ced6", 0.25)); lam.position.y = -0.1; gq.add(lam); return gq; }
    const fer = { broxa: broxa(), rolo: rolo(), lixa: lixa(), espatula: espatula() };

    // ---------- chuva ----------
    const NG = 700, rr = rnd(5), base = new Float32Array(NG * 3);
    for (let i = 0; i < NG; i++) { base[i * 3] = (rr() - 0.5) * 6; base[i * 3 + 1] = rr() * 4; base[i * 3 + 2] = -0.1 + rr() * 3.2; }
    const chuvaGeo = new THREE.BufferGeometry(); const chuvaPos = new Float32Array(NG * 6);
    chuvaGeo.setAttribute("position", new THREE.BufferAttribute(chuvaPos, 3));
    const chuva = new THREE.LineSegments(chuvaGeo, new THREE.LineBasicMaterial({ color: "#d6e6f5", transparent: true, opacity: 0.7 }));
    scene.add(chuva);
    function chover(t, k) {
      chuva.visible = k > 0.02; if (!chuva.visible) return;
      chuva.material.opacity = 0.7 * k;
      for (let i = 0; i < NG; i++) {
        const y = 4 - ((base[i * 3 + 1] + t * 6) % 4);
        chuvaPos.set([base[i * 3], y, base[i * 3 + 2], base[i * 3] - 0.01, y - 0.12, base[i * 3 + 2]], i * 6);
      }
      chuvaGeo.attributes.position.needsUpdate = true;
    }
    // nuvem de chuva
    const nuvens = new THREE.Group();
    for (let i = 0; i < 6; i++) { const s = new THREE.Mesh(new THREE.SphereGeometry(0.5 + (i % 3) * 0.15, 16, 12), new THREE.MeshStandardMaterial({ color: "#9aa6b5", roughness: 1, transparent: true, opacity: 0 })); s.position.set(-1.6 + i * 0.65, 3.9 + (i % 2) * 0.2, 0.6); nuvens.add(s); }
    scene.add(nuvens);

    // pó do lixamento
    const NP = 120, poGeo = new THREE.BufferGeometry(), poPos = new Float32Array(NP * 3);
    poGeo.setAttribute("position", new THREE.BufferAttribute(poPos, 3));
    const po = new THREE.Points(poGeo, new THREE.PointsMaterial({ color: "#e9e1d0", size: 0.025, transparent: true, opacity: 0.8 }));
    scene.add(po);

    // ---------- céu (dia/noite) ----------
    const ceuDia = new THREE.Color("#a9d4f2"), ceuNoite = new THREE.Color("#16213f"), ceuChuva = new THREE.Color("#8d9aaa"), tmp = new THREE.Color();

    // ---------- câmera: planos por trecho ----------
    const P = {
      aberta: { pos: [2.2, 1.5, 5.6], alvo: [0, 1.1, 0] },
      frente: { pos: [0.0, 0.85, 2.7], alvo: [0, 0.65, 0.6] },
      media: { pos: [1.7, 1.0, 3.0], alvo: [0.05, 0.85, 0.2] },
      lado: { pos: [2.1, 1.05, 1.6], alvo: [0, 0.9, 0.3] },
      parede: { pos: [0.7, 1.1, 1.5], alvo: [0.3, 0.95, 0] },
      close: { pos: [0.15, 0.85, 1.75], alvo: [0, 0.82, 0.75] },
      balde: { pos: [1.25, 0.55, 1.95], alvo: [0.5, 0.18, 0.7] },
    };
    const PLANOS = [
      [0, "aberta"], [1.3, "frente"], [C.d1, "media"], [C.chuva1, "aberta"], [C.d2, "lado"], [C.ent2, "frente"], [C.chuva2, "aberta"],
      [C.d3, "media"], [C.porem3, "parede"], [C.agora3, "frente"], [C.d4, "lado"], [C.existe4, "parede"], [C.d5, "media"],
      [C.soque5, "aberta"], [C.d6, "media"], [C.agora6, "aberta"], [C.d7, "aberta"], [C.faca7, "frente"], [C.recap, "balde"], [C.recap + 2.2, "aberta"], [C.cta, "close"],
    ];
    const vA = new THREE.Vector3(), vB = new THREE.Vector3(), alvo = new THREE.Vector3();
    function cam(t) {
      let i = PLANOS.findLastIndex((p) => p[0] <= t);
      const [t0, nome] = PLANOS[i], ant = PLANOS[i - 1];
      const k = ant ? sm(t0, t0 + (t0 === C.recap + 2.2 ? 3.2 : 0.9), t) : 1;
      const a = ant ? P[ant[1]] : P[nome], b = P[nome];
      const deriva = Math.sin(t * 0.25) * 0.05;
      vA.set(...a.pos); vB.set(...b.pos); camera.position.lerpVectors(vA, vB, k); camera.position.x += deriva;
      vA.set(...a.alvo); vB.set(...b.alvo); alvo.lerpVectors(vA, vB, k);
      camera.lookAt(alvo);
    }

    // ---------- roteiro do pintor ----------
    // [início, pose, frente para a parede?, ferramenta, x]
    const ATOS = [
      [0, "idle", false, null, 0.1], [C.d1, "pegar", false, null, 0.1], [C.d1 + 1.2, "pintar_broxa", true, "broxa", 0.1],
      [C.chuva1, "olhar_em_volta", false, "broxa", 0.1], [C.d2, "pintar_rolo", true, "rolo", 0.1], [C.ent2, "explicar", false, "rolo", 0.1],
      [C.chuva2, "pensar", false, null, 0.1], [C.d3, "pintar_rolo", true, "rolo", 0.1], [C.d3 + 5, "apontar", false, "rolo", 0.1],
      [C.porem3, "olhar_em_volta", false, null, 0.1], [C.agora3, "explicar", false, null, 0.1],
      [C.d4, "lixar", true, "lixa", 0.1], [C.d4 + 5.2, "pintar_rolo", true, "rolo", 0.1], [C.existe4, "apontar", false, null, 0.1],
      [C.d5, "lixar", true, "espatula", 0.1], [C.d5 + 6.5, "explicar", false, null, 0.1], [C.soque5, "pensar", false, null, 0.1],
      [C.d6, "pintar_rolo", true, "rolo", 0.1], [C.agora6, "joinha", false, null, 0.1],
      [C.d7, "explicar", false, null, 0.1], [C.d7 + 5, "apontar", false, null, 0.1], [C.d7 + 9, "explicar", false, null, 0.1], [C.faca7, "joinha", false, null, 0.1],
      [C.recap, "idle", false, null, 0.1], [C.recap + 2.6, "comemorar", false, null, 0.1], [C.cta, "acenar", false, null, 0.1],
    ];
    let pintor = null;
    const FADE = 0.45;
    function atuar(t) {
      const i = ATOS.findLastIndex((a) => a[0] <= t), at = ATOS[i], ant = ATOS[i - 1];
      const k = ant ? sm(at[0], at[0] + FADE, t) : 1;
      const pa = ant ? POSES[ant[1]](t) : {}, pb = POSES[at[1]](t);
      const pose = misturar(pa, pb, k);
      const ryA = ant && ant[2] ? Math.PI * 0.82 : 0, ryB = at[2] ? Math.PI * 0.82 : 0;
      pose.raiz = { ...(pose.raiz || {}), ry: lerp(ryA, ryB, k) };
      pintor.pose(pose);
      pintor.root.position.set(at[4], 0.04, at[2] ? lerp(0.55, 0.45, k) : 0.62);
      for (const [nome, obj] of Object.entries(fer)) obj.visible = at[3] === nome;
    }

    // ---------- relógio ----------
    function render(t) {
      desenharParede(t);
      // céu e luz
      const chuvaK = Math.max(sm(C.chuva1, C.chuva1 + 0.8, t) * (1 - sm(C.d2 - 0.6, C.d2, t)), sm(C.chuva2, C.chuva2 + 0.8, t) * (1 - sm(C.d3 - 0.6, C.d3, t)), sm(C.agora6 + 0.3, C.agora6 + 1, t) * (1 - sm(C.d7 - 0.8, C.d7, t)));
      const ciclo = t > C.soque5 && t < C.d6 ? Math.sin(((t - C.soque5) / (C.d6 - C.soque5)) * Math.PI * 2) : 0; // dia → noite → dia
      const noite = Math.max(0, -ciclo) * 0.9;
      const lapso = t > C.porem3 && t < C.agora3 ? (t - C.porem3) / (C.agora3 - C.porem3) : 0; // meses passando
      tmp.copy(ceuDia).lerp(ceuChuva, chuvaK).lerp(ceuNoite, noite);
      scene.background = tmp.clone(); renderer.setClearColor(tmp);
      const ang = lapso > 0 ? lapso * Math.PI * 6 : t > C.soque5 && t < C.d6 ? ((t - C.soque5) / (C.d6 - C.soque5)) * Math.PI * 2 : 0.6;
      sol.position.set(Math.cos(ang) * 4 + 2, 5 * Math.max(0.25, Math.abs(Math.sin(ang + 1.2))), 4);
      sol.intensity = 2.4 * (1 - 0.65 * chuvaK) * (1 - noite);
      hemi.intensity = 0.6 * (1 - 0.5 * noite);
      nuvens.children.forEach((s, i) => { s.material.opacity = chuvaK * 0.95; s.position.x = -1.6 + i * 0.65 + Math.sin(t * 0.3 + i) * 0.1; });
      chover(t, chuvaK);
      // latas aparecem quando o degrau começa
      for (const [t0, l] of latas) l.visible = t >= t0 + 0.4 || t < 1.3 || t >= C.recap;
      // pó do lixamento
      const poK = t > C.d4 && t < C.d4 + 5 ? 1 : 0; po.visible = poK > 0;
      if (poK) { const r = rnd(9); for (let i = 0; i < NP; i++) { const f = ((r() + (t - C.d4) * 0.35) % 1); poPos.set([0.05 + (r() - 0.5) * 0.5, 0.55 + f * 0.6, 0.15 + r() * 0.3], i * 3); } poGeo.attributes.position.needsUpdate = true; }
      if (pintor) atuar(t);
      cam(t);
      renderer.render(scene, camera);
    }

    new GLTFLoader().loadAsync("assets/pintor.glb").then((gltf) => {
      pintor = criarPintor(THREE, gltf.scene);
      scene.add(pintor.root);
      const mao = pintor.osso("maoD");
      for (const o of Object.values(fer)) { o.traverse((m) => { if (m.isMesh) m.castShadow = true; }); o.position.set(-0.03, -0.02, 0.02); mao.add(o); }
      return document.fonts.ready;
    }).then(() => {
      const st = { t: 0 };
      const tl = gsap.timeline({ paused: true });
      tl.to(st, { t: C.end, duration: C.end, ease: "none", onUpdate: () => render(st.t) }, 0);
      render(0);
      window.__timelines["world"] = tl;
    });
  </script>
</template>
